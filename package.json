{
  "name": "my-nhipster-app",
  "version": "0.0.0",
  "private": true,
  "description": "Description for myNhipsterApp",
  "license": "UNLICENSED",
  "scripts": {
    "app:up": "docker compose -f docker/app.yml up --wait",
    "build": "pnpm --filter ./server run build && pnpm --filter ./client run build",
    "build:app": "pnpm --filter ./server run build",
    "ci:e2e:prepare": "pnpm run ci:e2e:prepare:docker",
    "ci:e2e:prepare:docker": "pnpm run services:up --if-present && docker ps -a",
    "ci:e2e:teardown": "pnpm run ci:e2e:teardown:docker --if-present",
    "ci:e2e:teardown:docker": "docker compose -f docker/services.yml down -v && docker ps -a",
    "ci:frontend:test": "pnpm --filter ./client run ci:frontend:test",
    "docker:db:down": "docker compose -f docker/postgresql.yml down -v",
    "docker:db:up": "docker compose -f docker/postgresql.yml up --wait",
    "lint:fix": "echo \"INFO: no client found\"",
    "prepare": "husky",
    "prettier:check": "prettier --check \"{,src/**/,webpack/,.blueprint/**/}*.{md,json,yml,js,cjs,mjs,ts,cts,mts,html,tsx,css,scss}\"",
    "prettier:format": "prettier --write \"{,src/**/,webpack/,.blueprint/**/}*.{md,json,yml,js,cjs,mjs,ts,cts,mts,html,tsx,css,scss}\"",
    "services:up": "docker compose -f docker/services.yml up --wait",
    "start": "concurrently -k -s first -n application,client -c red,green \"pnpm run start:server\" \"pnpm run start:client\"",
    "start:client": "pnpm --filter ./client run start",
    "start:server": "pnpm --filter ./server run start",
    "test": "echo \"INFO: no client test found\"",
    "test:client": "pnpm --filter ./client test",
    "test:server": "pnpm --filter ./server test",
    "test:server:e2e": "pnpm --filter ./server run test:e2e",
    "webapp:build": "pnpm --filter ./client run webapp:build"
  },
  "config": {
    "default_environment": "prod"
  },
  "devDependencies": {
    "@eslint/js": "9.23.0",
    "browser-sync-client": "3.0.4",
    "eslint": "9.14.0",
    "eslint-config-prettier": "10.1.1",
    "generator-jhipster": "8.10.0",
    "generator-jhipster-nodejs": "3.2.0",
    "globals": "16.0.0",
    "husky": "9.1.7",
    "lint-staged": "15.5.0",
    "prettier": "3.5.3",
    "prettier-plugin-packagejson": "2.5.10",
    "typescript-eslint": "8.29.0"
  },
  "packageManager": "pnpm@10.26.0",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "bcrypt",
      "sqlite3",
      "unrs-resolver"
    ],
    "overrides": {
      "browser-sync": "3.0.3"
    },
    "ignoredBuiltDependencies": [
      "@scarf/scarf",
      "core-js"
    ]
  }
}
